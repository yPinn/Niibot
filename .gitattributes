# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# SQL files
*.sql text eol=lf

# YAML / JSON / TOML
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Config files
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Dockerfile* text eol=lf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Archives (binary)
*.zip binary
*.tar binary
*.gz binary
*.rar binary
