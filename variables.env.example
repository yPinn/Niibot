# GitHub Variables template — copy to variables.env and fill in values.
# Upload all at once with: bash scripts/push-secrets.sh
# Non-sensitive; safe to inspect in workflow logs.

# ── API ───────────────────────────────────────────────────────────────────────
# API server public URL — used for OAuth redirect URIs and donation webhook callbacks.
API_URL=
ENVIRONMENT=production

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
DISCORD_ACTIVITY_URL=

# ── Scrapling ─────────────────────────────────────────────────────────────────
SCRAPLING_PORT=3001
