# GitHub Variables template — copy to variables.env, fill in, then run: bash scripts/push-secrets.sh
# Non-sensitive; safe to inspect in workflow logs.

# ── API ───────────────────────────────────────────────────────────────────────
# Public URL — used for OAuth redirect URIs and webhook callbacks
API_URL=
ENVIRONMENT=production

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
DISCORD_ACTIVITY_URL=

# ── Scrapling ─────────────────────────────────────────────────────────────────
SCRAPLING_PORT=3001
