# Root .env — read by Docker Compose for variable interpolation.
# Production: written automatically from GitHub Secrets on each deploy (see .github/workflows/deploy.yml).
# Local dev: copy to .env and fill in values. Never commit .env.

# === Service ports (optional — defaults shown) ===
# SCRAPLING_PORT=3001

# === PostgreSQL ===
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=your_db_name_here

# === Docker DATABASE_URL override ===
# Containers cannot reach localhost — they must use the Docker service name.
# This overrides DATABASE_URL from shared.env for all services in docker-compose.yml.
# Format: postgresql://USER:PASSWORD@postgres:5432/DB  (host = postgres service name)
DOCKER_DATABASE_URL=postgresql://your_db_user_here:your_db_password_here@postgres:5432/your_db_name_here
