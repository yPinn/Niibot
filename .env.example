# Root .env — read by Docker Compose for variable substitution.
# Copy to .env and fill in values. Never commit .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Docker internal DB URL ────────────────────────────────────────────────────
# Containers cannot reach localhost — they use the Docker service name.
# Format: postgresql://USER:PASSWORD@postgres:5432/DB
DOCKER_DATABASE_URL=
