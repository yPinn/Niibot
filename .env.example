# === PostgreSQL (Docker Compose) ===
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=your_db_name_here

# === Cloudflare Tunnel (production only) ===
# Token from: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Configure > Token
# In the tunnel's Public Hostname, set the service URL to: http://api:8000
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
