# GENERATED by scripts/env/gen.py — do not edit; edit env.registry.toml
# GitHub Secrets — staging (environment-specific, overrides base).
# Copy to .github/secrets/stg.env and fill in values. Never commit it.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# 產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 部署必填且不可任意更換。產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_SECRET=
# 初始化時產生；加密既有 token 後不可更換。
TWITCH_TOKEN_ENCRYPTION_KEY=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── AI ────────────────────────────────────────────────────────────────────────
# 至少設定一組 API key 與對應 model。
# GROQ_API_KEY=
# 來源：Google AI Studio。
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── Integrations ──────────────────────────────────────────────────────────────
# YOUTUBE_API_KEY=
# 需要 read:contents 權限。
# RELEASES_GITHUB_TOKEN=
