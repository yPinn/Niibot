# GitHub Secrets — production Environment overrides.
# Copy to .github/secrets/prod.env, fill in, then run: bash .github/push.sh prod
# Never commit .github/secrets/prod.env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=

# ── API ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
