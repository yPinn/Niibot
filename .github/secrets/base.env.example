# GitHub Secrets — shared base (all environments).
# Copy to .github/secrets/base.env, fill in, then run: bash .github/push.sh prod
# Never commit secrets/base.env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── API ───────────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
BOT_ID=
OWNER_ID=
CONDUIT_ID=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# discord.com/developers/applications → General Information → Public Key
DISCORD_PUBLIC_KEY=

# ── Session cookies (~90-day expiry) ──────────────────────────────────────────
INSTAGRAM_SESSION_ID=
THREADS_SESSION_ID=

# ── AI providers — set at least one; empty keys are skipped ───────────────────
# console.groq.com
GROQ_API_KEY=
# aistudio.google.com — use AI Studio key, NOT a Google Cloud project key
GEMINI_API_KEY=
# openrouter.ai — free :free models; fallbacks from data/free_models.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
YOUTUBE_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# PAT for reading private repo releases (github.com/settings/tokens — needs `repo` scope)
RELEASES_GITHUB_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Discord webhook for ERROR/CRITICAL alerts across all services
ERROR_WEBHOOK_URL=
