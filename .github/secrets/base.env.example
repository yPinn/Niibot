# GitHub Secrets — base (shared across all environments).
# Copy → .github/secrets/base.env, fill in, never commit.

# ── AI providers (set at least one; empty keys are ignored) ───────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
YOUTUBE_API_KEY=

# ── Session cookies (~90-day expiry) ──────────────────────────────────────────
INSTAGRAM_SESSION_ID=
THREADS_SESSION_ID=

# ── GitHub ────────────────────────────────────────────────────────────────────
# PAT with repo scope — github.com/settings/tokens
RELEASES_GITHUB_TOKEN=
