# GENERATED by scripts/env/gen.py — do not edit; edit env.registry.toml
# GitHub Secrets — base (shared across all environments).
# Copy to .github/secrets/base.env and fill in values. Never commit it.

# ── AI ────────────────────────────────────────────────────────────────────────
# Set at least one provider key and its explicit model. Twitch: Groq → OpenRouter; Discord: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
# From aistudio.google.com; not a GCP service account.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Integrations ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
# From github.com/settings/tokens; needs read:contents scope.
RELEASES_GITHUB_TOKEN=
# From the instagram.com 'sessionid' cookie; ~90-day expiry.
INSTAGRAM_SESSION_ID=
