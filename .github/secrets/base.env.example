# GENERATED by scripts/gen_env.py — do not edit; edit env.registry.toml
# GitHub Secrets — base (shared across all environments).
# Copy → .github/secrets/base.env, fill in, never commit.

# ── AI ────────────────────────────────────────────────────────────────────────
# aistudio.google.com key (not a GCP service account).
GEMINI_API_KEY=
# Set at least one AI key; blanks are skipped. Order: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Service ───────────────────────────────────────────────────────────────────
# threads.com cookie 'sessionid' (DevTools → Application → Cookies); ~90-day expiry
THREADS_SESSION_ID=

# ── Integrations ──────────────────────────────────────────────────────────────
# ~90-day expiry.
INSTAGRAM_SESSION_ID=
# PAT with read:contents scope (github.com/settings/tokens).
RELEASES_GITHUB_TOKEN=
YOUTUBE_API_KEY=
