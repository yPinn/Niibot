# GitHub Secrets — base (all-environment fallback).
# Copy → .github/secrets/base.env, fill in, never commit.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
BOT_ID=
OWNER_ID=
CONDUIT_ID=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# discord.com/developers/applications → General Information → Public Key
DISCORD_PUBLIC_KEY=

# ── Session cookies (~90-day expiry) ──────────────────────────────────────────
INSTAGRAM_SESSION_ID=
THREADS_SESSION_ID=

# ── AI providers (set at least one; empty keys are ignored) ───────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
YOUTUBE_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# PAT with repo scope — github.com/settings/tokens
RELEASES_GITHUB_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────────────
ERROR_WEBHOOK_URL=
