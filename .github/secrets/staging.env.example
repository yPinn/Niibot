# GitHub Secrets — staging Environment overrides.
# Copy to .github/secrets/staging.env, fill in, then run: bash .github/push.sh staging
# Never commit .github/secrets/staging.env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=

# ── API ───────────────────────────────────────────────────────────────────────
# Staging CF Pages URL
FRONTEND_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
