# GitHub Variables — base (all-environment fallback).
# Copy → .github/variables/base.env, fill in.

# ── Runner ────────────────────────────────────────────────────────────────────
PROJECT_DIR=

# ── API ───────────────────────────────────────────────────────────────────────
API_URL=
ENVIRONMENT=

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=
DISCORD_ACTIVITY_NAME=
DISCORD_ACTIVITY_URL=

# ── Scrapling ─────────────────────────────────────────────────────────────────
SCRAPLING_PORT=3001
