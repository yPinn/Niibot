# GitHub Variables — shared base defaults (applied to all environments).
# Copy to .github/variables/base.env, fill in, then run: bash .github/push.sh prod
# Non-sensitive; safe to inspect in workflow logs.

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
DISCORD_ACTIVITY_URL=

# ── Scrapling ─────────────────────────────────────────────────────────────────
SCRAPLING_PORT=3001
