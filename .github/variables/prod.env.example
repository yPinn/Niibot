# GitHub Variables — production Environment overrides.
# Copy to .github/variables/prod.env, fill in, then run: bash .github/push.sh prod
# Never commit .github/variables/prod.env.

# ── API ───────────────────────────────────────────────────────────────────────
# Public URL for OAuth redirect URIs and webhook callbacks
API_URL=
ENVIRONMENT=production

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=online
