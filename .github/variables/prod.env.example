# GENERATED by scripts/env/gen.py — do not edit; edit env.registry.toml
# GitHub Variables — production (overrides base per-environment).
# Copy to .github/variables/prod.env and fill in values.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_DB=

# ── App ───────────────────────────────────────────────────────────────────────
# 供 CORS、OAuth redirect 與公開素材使用。
FRONTEND_URL=
# 供 OAuth callback 與付款 webhook 使用。
API_URL=https://niibot.llazypilot.com
# 高頻公開端點（直播插播 HLS 畫質播放清單）直連此網址，不計入 Pages Functions 額度；留空則走 API_URL 代理。
# API_DIRECT_URL=https://niibot-api.llazypilot.com
# development、staging 或 production。
ENVIRONMENT=production

# ── Twitch ────────────────────────────────────────────────────────────────────
# prod 與 nonprod 各一組；dev 使用 staging 值。
TWITCH_CLIENT_ID=
# 填數字 ID；prod 與 nonprod 使用不同 bot 帳號。
BOT_ID=
# CONDUIT_ID=

# ── Presence ──────────────────────────────────────────────────────────────────
# online、idle、dnd 或 invisible。
DISCORD_STATUS=online
# playing、listening、watching、competing、streaming 或 custom。
DISCORD_ACTIVITY_TYPE=streaming
# DISCORD_ACTIVITY_NAME=尖尖哇嘎奈...
# 僅 streaming 使用，且須為 Twitch 頻道 URL。
# DISCORD_ACTIVITY_URL=https://www.twitch.tv/llazypilot

# ── Integrations ──────────────────────────────────────────────────────────────
# dash.cloudflare.com 網址中的 32 字元 ID；與 CLOUDFLARE_API_TOKEN 一起設定才會顯示 Workers／Pages Functions 今日用量。
# CLOUDFLARE_ACCOUNT_ID=
# prod 與 nonprod 各一組；dev 使用 staging 值。
# NIGHTBOT_CLIENT_ID=
# 僅啟用 Webhook Events 時設定；dev 使用 staging 值。
# DISCORD_PUBLIC_KEY=

# ── Deployment ────────────────────────────────────────────────────────────────
# production 與 staging 必須使用不同目錄，且分別固定在 main 與 staging。
PROJECT_DIR=
# 僅 staging 讀取；留空則 staging 不自動同步。production 一律同步 global。
# DISCORD_SYNC_GUILD_ID=
