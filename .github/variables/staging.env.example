# GitHub Variables — staging Environment overrides.
# Copy to .github/variables/staging.env, fill in, then run: bash .github/push.sh staging
# Never commit .github/variables/staging.env.

# ── API ───────────────────────────────────────────────────────────────────────
# Staging API public URL (Cloudflare Tunnel → localhost:8001)
API_URL=
ENVIRONMENT=staging

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=idle
