# GitHub Variables — staging (overrides base per-environment).
# Copy → .github/variables/staging.env, fill in.

# ── Runner ────────────────────────────────────────────────────────────────────
PROJECT_DIR=

# ── API ───────────────────────────────────────────────────────────────────────
# Cloudflare Tunnel → localhost:8001
API_URL=
ENVIRONMENT=staging

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_STATUS=dnd
DISCORD_ACTIVITY_TYPE=listening
DISCORD_ACTIVITY_NAME=STYX HELIX
DISCORD_ACTIVITY_URL=

# ── Scrapling ─────────────────────────────────────────────────────────────────
SCRAPLING_PORT=3003
