!.env.example
!**/.env.example
!shared.env.example
!**/shared.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
.venv

# Type Checking & Linting
.mypy_cache/
.ruff_cache/
.cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
frontend/coverage/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# PostgreSQL data directory (bind mount from docker-compose)
data/postgres/

# Database backups
data/backups/

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
__MACOSX/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# Task tracking (session-specific, lessons.md should be tracked)
tasks/todo.md
