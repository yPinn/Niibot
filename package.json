{
  "name": "niibot",
  "description": "多平台直播整合 Bot - 支援 Twitch 和 Discord。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "dev:fe": "npm run dev --prefix frontend",
    "dev:api": "npm run dev:compose -- --profile api up --build --remove-orphans",
    "dev:twitch": "npm run dev:compose -- --profile twitch up --build --remove-orphans",
    "dev:discord": "npm run dev:compose -- --profile discord up --build --remove-orphans",
    "dev:bots": "npm run dev:compose -- --profile bots up --build --remove-orphans",
    "dev:full": "npm run dev:compose -- --profile full up --build --remove-orphans",
    "dev:db": "npm run dev:compose -- up -d postgres",
    "dev:down": "npm run dev:compose -- down --remove-orphans",
    "dev:compose": "npm run nb -- stack dev compose",
    "lint": "npm run lint --prefix frontend && uv run --directory backend ruff check .",
    "typecheck": "npm run typecheck --prefix frontend && uv run --directory backend mypy .",
    "test": "npm run test:cov --prefix frontend -- --run && uv run --directory backend pytest tests",
    "format": "npm run format --prefix frontend && uv run --directory backend ruff format .",
    "fix": "npm run lint:fix --prefix frontend && npm run format --prefix frontend && uv run --directory backend ruff check --fix . && uv run --directory backend ruff format .",
    "nb": "uv run --directory backend python scripts/nb.py",
    "env:gen": "uv run --no-project python scripts/env/gen.py",
    "env:check": "uv run --no-project python scripts/env/gen.py --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yPinn/Niibot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yPinn/Niibot/issues"
  },
  "homepage": "https://github.com/yPinn/Niibot#readme",
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "env.registry.toml": [
      "uv run --no-project python scripts/env/gen.py --check"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npx --prefix frontend eslint --config frontend/eslint.config.js --cache --cache-location frontend/.cache/eslint/ --fix",
      "npx --prefix frontend prettier --write --ignore-unknown"
    ],
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix --config backend/pyproject.toml --cache-dir backend/.cache/ruff",
      "uv run --project backend ruff format --config backend/pyproject.toml --cache-dir backend/.cache/ruff"
    ],
    "docs/**/*.md": [
      "npx --prefix frontend markdownlint --fix",
      "npx --prefix frontend prettier --write --ignore-unknown"
    ],
    "**/*.{json,yml,yaml}": [
      "npx --prefix frontend prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "secretlint": "^13.0.5"
  }
}
