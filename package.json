{
  "name": "niibot",
  "description": "多平台直播整合 Bot - 支援 Twitch 和 Discord。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky install",
    "_dc": "docker compose -f docker-compose.yml -f docker-compose.dev.yml",
    "format": "npm run format --prefix frontend && uv run --project backend ruff format backend",
    "lint": "npm run lint --prefix frontend && uv run --project backend ruff check backend",
    "typecheck": "npm run typecheck --prefix frontend && uv run --project backend --directory backend mypy .",
    "fix": "npm run format && npm run lint",
    "test": "npm run lint && npm run typecheck",
    "dev:fe": "npm run dev --prefix frontend",
    "dev:api": "npm run _dc -- --profile api up --build --remove-orphans",
    "dev:twitch": "npm run _dc -- --profile twitch up --build --remove-orphans",
    "dev:discord": "npm run _dc -- --profile discord up --build --remove-orphans",
    "dev:bots": "npm run _dc -- --profile bots up --build --remove-orphans",
    "dev:full": "npm run _dc -- --profile full up --build --remove-orphans",
    "build": "docker compose -f docker-compose.yml --profile full build",
    "docker:db": "npm run _dc -- up postgres",
    "docker:down": "npm run _dc -- down --remove-orphans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yPinn/Niibot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yPinn/Niibot/issues"
  },
  "homepage": "https://github.com/yPinn/Niibot#readme",
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npx --prefix frontend eslint --config frontend/eslint.config.js --cache --cache-location frontend/.cache/eslint/ --fix",
      "npx --prefix frontend prettier --write --ignore-unknown"
    ],
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix --config backend/pyproject.toml --cache-dir backend/.cache/ruff",
      "uv run --project backend ruff format --config backend/pyproject.toml --cache-dir backend/.cache/ruff"
    ],
    "docs/**/*.md": [
      "npx --prefix frontend markdownlint --fix",
      "npx --prefix frontend prettier --write --ignore-unknown"
    ],
    "**/*.{json,yml,yaml}": [
      "npx --prefix frontend prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "secretlint": "^11.3.1"
  }
}
