# GitHub Secrets template — copy to secrets.env and fill in values.
# Upload all at once with: bash scripts/push-secrets.sh
# Never commit secrets.env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
BOT_ID=
OWNER_ID=
CONDUIT_ID=
# YouTube Data API — used by Twitch bot video queue and API video router
YOUTUBE_API_KEY=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Social Preview — session cookies (~90-day expiry) ─────────────────────────
INSTAGRAM_SESSION_ID=
THREADS_SESSION_ID=

# ── AI ────────────────────────────────────────────────────────────────────────
# Used by Discord bot and Twitch bot AI commands.
# Set at least one provider. Providers with empty keys are skipped automatically.

# Groq — free tier, no billing needed (console.groq.com)
# Priority: speed-first for Twitch, fallback for Discord
GROQ_API_KEY=

# Gemini AI Studio — free tier, use AI Studio key only (aistudio.google.com)
# Priority: quality-first for Discord, fallback for Twitch
GEMINI_API_KEY=

# OpenRouter — free :free models after any credit load (openrouter.ai)
# Primary model + fallbacks from data/free_models.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Discord webhook — error alerts shared across all services
ERROR_WEBHOOK_URL=
