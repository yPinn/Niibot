# GitHub Secrets template — copy to secrets.env, fill in, then run: bash scripts/push-secrets.sh
# Never commit secrets.env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
BOT_ID=
OWNER_ID=
CONDUIT_ID=
YOUTUBE_API_KEY=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Session cookies (~90-day expiry) ──────────────────────────────────────────
INSTAGRAM_SESSION_ID=
THREADS_SESSION_ID=

# ── AI providers — set at least one; empty keys are skipped ───────────────────
# console.groq.com
GROQ_API_KEY=
# aistudio.google.com — use AI Studio key, NOT a Google Cloud project key
GEMINI_API_KEY=
# openrouter.ai — free :free models; fallbacks from data/free_models.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Discord webhook for ERROR/CRITICAL alerts across all services
ERROR_WEBHOOK_URL=
