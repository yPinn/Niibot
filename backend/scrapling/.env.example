# Scrapling sidecar.
# Copy to .env and fill in values. Never commit .env.

# ── Service ───────────────────────────────────────────────────────────────────
PORT=3001
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Session cookies ───────────────────────────────────────────────────────────
# threads.com → F12 → Application → Cookies → sessionid; ~90-day expiry
THREADS_SESSION_ID=

# ── Monitoring ────────────────────────────────────────────────────────────────
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG
