# Scrapling sidecar environment variables.
# Copy to .env and fill in values. Never commit .env.

PORT=3001
LOG_LEVEL=INFO

# Threads session cookie — required for authenticated caption scraping.
# Log in to threads.com → F12 → Application → Cookies → copy sessionid value.
# URL-encoded value is accepted. Expires ~90 days; renew manually.
THREADS_SESSION_ID=
