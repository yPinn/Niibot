# Discord bot overrides.
# Create a runtime set with: npm run nb -- env init <dev|stg|prod>
# Never commit runtime env files.

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Overrides Developer Portal bio (max 400 chars).
# DISCORD_DESCRIPTION=

# ── Presence ──────────────────────────────────────────────────────────────────
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# Streaming type only; must be a twitch.tv URL.
# DISCORD_ACTIVITY_URL=

# ── Integrations ──────────────────────────────────────────────────────────────
# From the instagram.com 'sessionid' cookie; ~90-day expiry.
# INSTAGRAM_SESSION_ID=

# ── Dev ───────────────────────────────────────────────────────────────────────
# DISCORD_STATUS=dnd
# Set once after adding/changing slash commands.
# DISCORD_SYNC_COMMANDS=true
# Guild-scoped command sync (faster than global).
# DISCORD_GUILD_ID=
# Threads sidecar host; empty = disabled.
# SCRAPLING_HOST=localhost:3001
# PORT=8080
