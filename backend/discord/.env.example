# Discord bot env.
# Twitch App credentials → shared.env

DISCORD_BOT_TOKEN=

# Presence
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing   # watching / listening / playing / streaming
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=   # streaming type only (must be a twitch.tv URL)

# Optional
# INSTAGRAM_SESSION_ID=   # Instagram profile embeds (~90-day expiry)

# Dev
# DISCORD_SYNC_COMMANDS=true   # set once after adding/changing slash commands
# DISCORD_GUILD_ID=            # guild ID for faster guild-scoped command sync
# LOG_LEVEL=DEBUG
