# Discord bot. App credentials → shared.env.
# Copy to .env and fill in values. Never commit .env.

# ── Bot ───────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Presence ──────────────────────────────────────────────────────────────────
# Status: online | idle | dnd | invisible
DISCORD_STATUS=online
# Type: playing | listening | watching | competing | streaming | custom
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=   # streaming type only (must be a twitch.tv URL)

# ── Integrations ──────────────────────────────────────────────────────────────
# DISCORD_DESCRIPTION=    # overrides Developer Portal bio (max 400 chars)
# INSTAGRAM_SESSION_ID=   # Instagram embeds; ~90-day expiry

# ── Monitoring ────────────────────────────────────────────────────────────────
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# DISCORD_STATUS=dnd
# INSTAFIX_HOST=localhost:3000    # Docker sets this via compose; needed for direct-run
# SCRAPLING_HOST=localhost:3001
# PORT=8080
# LOG_LEVEL=DEBUG
# DISCORD_SYNC_COMMANDS=true     # set once after adding/changing slash commands
# DISCORD_GUILD_ID=              # guild-scoped sync, faster
