# Discord bot overrides.
# Create a runtime set with: npm run nb -- env init <dev|stg|prod>
# Never commit runtime env files.

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# 覆蓋 Developer Portal bio，上限 400 字。
# DISCORD_DESCRIPTION=

# ── Presence ──────────────────────────────────────────────────────────────────
# online、idle、dnd 或 invisible。
DISCORD_STATUS=online
# playing、listening、watching、competing、streaming 或 custom。
DISCORD_ACTIVITY_TYPE=playing
# DISCORD_ACTIVITY_NAME=
# 僅 streaming 使用，且須為 Twitch 頻道 URL。
# DISCORD_ACTIVITY_URL=

# ── Integrations ──────────────────────────────────────────────────────────────
# 來源：Instagram cookie，約 90 天到期。
# INSTAGRAM_SESSION_ID=

# ── Dev ───────────────────────────────────────────────────────────────────────
# online、idle、dnd 或 invisible。
# DISCORD_STATUS=dnd
# 變更 slash command 後設為 true 一次。
# DISCORD_SYNC_COMMANDS=true
# Guild 同步比 global 快。
# DISCORD_GUILD_ID=
# 空值停用 Threads 預覽。
# SCRAPLING_HOST=localhost:3001
# PORT=8080
