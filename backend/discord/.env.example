# Discord bot env.
# Twitch App credentials → shared.env

DISCORD_BOT_TOKEN=

# Presence
# Status: online | idle | dnd | invisible
DISCORD_STATUS=online
# Activity type: playing | listening | watching | competing | streaming | custom
# streaming requires DISCORD_ACTIVITY_URL
# custom = pure text in hover card, no prefix
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=

# Profile description (overrides Developer Portal, max 400 chars)
# DISCORD_DESCRIPTION=

# Optional
# INSTAGRAM_SESSION_ID=   # Instagram profile embeds (~90-day expiry)

# Dev
# DISCORD_SYNC_COMMANDS=true   # set once after adding/changing slash commands
# DISCORD_GUILD_ID=            # guild ID for faster guild-scoped command sync
# LOG_LEVEL=DEBUG
