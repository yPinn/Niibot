# Discord Bot Token - discord.com/developers
DISCORD_BOT_TOKEN=

# Dev: slash command sync (set true once after adding/changing commands, then remove)
# DISCORD_SYNC_COMMANDS=true
# DISCORD_GUILD_ID=   # test guild for instant sync (dev only)

# Presence
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=  # required only for streaming type (must be twitch.tv URL)

# Server
PORT=8080

# Rate Limit Monitor
RATE_LIMIT_ENABLED=true

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=

# ── Instagram (Social Preview) ────────────────────────────────────────────────

# Self-hosted InstaFix (github.com/Wikidepia/InstaFix).
# Docker: "instafix:3000" | Local dev: "localhost:3000"
INSTAFIX_HOST=instafix:3000

# Instagram session cookie for profile embeds (optional).
# Without this, profile URLs fall back to a minimal @username embed.
# How to obtain: log into Instagram in a browser → F12 → Application →
#   Cookies → www.instagram.com → copy the value of "sessionid".
# Recommendation: use a dedicated dummy account, not your main account.
# INSTAGRAM_SESSION_ID=
