# Discord Bot Token — discord.com/developers
DISCORD_BOT_TOKEN=

# Dev: slash command sync (set true once after adding/changing commands, then remove)
# DISCORD_SYNC_COMMANDS=true
# DISCORD_GUILD_ID=   # test guild for instant sync (dev only)

# Presence
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=  # required only for streaming type (must be twitch.tv URL)

# Server
PORT=8080

# Rate Limit Monitor
RATE_LIMIT_ENABLED=true
