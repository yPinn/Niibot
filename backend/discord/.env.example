# Discord bot environment variables.
# Copy to .env and fill in values. Never commit .env.

# Discord Bot Token (discord.com/developers)
DISCORD_BOT_TOKEN=

# Dev sync (set true once after adding/changing slash commands, then remove)
# DISCORD_SYNC_COMMANDS=true
# DISCORD_GUILD_ID=

# Presence
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=   # streaming type only (must be twitch.tv URL)

# Server
PORT=8080
LOG_LEVEL=INFO

# Rate Limit Monitor
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WARNING_THRESHOLD=0.7
# RATE_LIMIT_CRITICAL_THRESHOLD=0.9

# Error reporting (optional)
# ERROR_WEBHOOK_URL=

# Social Preview — Docker: hosts injected by compose; uncomment for local dev
# INSTAFIX_HOST=localhost:3000    # Docker default in code: instafix:3000
# SCRAPLING_HOST=localhost:3001   # no default — must set to enable Threads captions

# Session cookies for authenticated scraping (optional)
# INSTAGRAM_SESSION_ID=   # Instagram profile embeds (sessionid cookie, ~90-day expiry)

# Twitch credentials → shared.env (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET)
