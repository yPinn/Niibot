# Discord bot environment variables.
# Production: written automatically from GitHub Secrets on each deploy (see .github/workflows/deploy.yml).
# Local dev: copy to .env and fill in values. Never commit .env.

DISCORD_BOT_TOKEN=

# Presence
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=playing
DISCORD_ACTIVITY_NAME=
# DISCORD_ACTIVITY_URL=   # streaming type only (must be twitch.tv URL)

# Session cookies for authenticated scraping (optional)
# INSTAGRAM_SESSION_ID=   # Instagram profile embeds (~90-day expiry)

# Twitch credentials → shared.env (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET)

# --- Dev only ---
# DISCORD_SYNC_COMMANDS=true   # set once after adding/changing slash commands, then remove
# DISCORD_GUILD_ID=            # guild ID for faster guild-scoped command sync
# LOG_LEVEL=DEBUG              # per-service override; default comes from shared.env
