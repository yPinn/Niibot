# === Discord Auth ===
DISCORD_BOT_TOKEN=your_discord_bot_token

# === AI (OpenRouter) ===
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# === Database ===
DATABASE_URL=postgresql://niibot:CHANGE_ME@postgres:5432/niibot

# === Commands ===
# DISCORD_SYNC_COMMANDS=true            # DEV only
# DISCORD_GUILD_ID=123456789            # DEV only, fast guild sync

# === Presence ===
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=streaming
DISCORD_ACTIVITY_NAME=your_stream_title
DISCORD_ACTIVITY_URL=https://twitch.tv/your_channel

# === Server ===
PYTHONUNBUFFERED=1
PORT=8080
# LOG_LEVEL=INFO

# === Rate Limit ===
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WARNING_THRESHOLD=0.7
# RATE_LIMIT_CRITICAL_THRESHOLD=0.9
