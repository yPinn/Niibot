# Twitch OAuth — dev.twitch.tv
CLIENT_ID=
CLIENT_SECRET=
BOT_ID=
OWNER_ID=

# AI (OpenRouter) — optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# PostgreSQL (Docker internal)
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/niibot

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=

# Service URLs
# Dev: http://localhost:3000 | Prod: CF Pages URL
FRONTEND_URL=

# EventSub Conduit (optional, for multi-channel EventSub)
# CONDUIT_ID=

# Server
PORT=4344
PYTHONUNBUFFERED=1
