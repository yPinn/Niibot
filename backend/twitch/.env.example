# Twitch bot environment variables.
# Production: written automatically from GitHub Secrets on each deploy (see .github/workflows/deploy.yml).
# Local dev: copy to .env and fill in values. Never commit .env.

# Twitch credentials → shared.env (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET)
# Bot identity → shared.env (BOT_ID — also needed by the API service)

OWNER_ID=

# EventSub Conduit (optional)
# CONDUIT_ID=
