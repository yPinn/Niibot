# API service environment variables.
# Copy to .env and fill in values. Never commit .env.

# Twitch OAuth credentials (dev.twitch.tv)
# Same Twitch App as TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET in shared.env —
# the API config reads CLIENT_ID / CLIENT_SECRET (without the TWITCH_ prefix).
CLIENT_ID=
CLIENT_SECRET=

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# Public-facing URLs
# Dev:  FRONTEND_URL=http://localhost:3000 / API_URL=http://localhost:8000
# Prod: both point to the CF Pages domain — CF Worker proxies /api/* to the backend tunnel,
#       so cookies are set on the CF Pages domain and SameSite=Lax works correctly.
FRONTEND_URL=
API_URL=

# Internal service URLs
# Defaults (local dev): http://localhost:4344 / http://localhost:8080
# Override for Docker — containers must use service names instead of localhost.
# These are set via docker-compose.yml environment block, not here.
# TWITCH_BOT_URL=http://twitch-bot:4344
# DISCORD_BOT_URL=http://discord-bot:8080

# Server
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO
# ENVIRONMENT=development   # local dev only

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=
