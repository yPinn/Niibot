# === Twitch OAuth ===
CLIENT_ID=your_twitch_client_id
CLIENT_SECRET=your_twitch_client_secret

# === Authentication ===
JWT_SECRET_KEY=your_jwt_secret_key
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# === Database ===
DATABASE_URL=postgresql://niibot:CHANGE_ME@postgres:5432/niibot

# === Discord OAuth ===
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret

# === YouTube Data API ===
# Required for fetching video title and duration when adding videos via dashboard or chat.
# Obtain from https://console.cloud.google.com/ → YouTube Data API v3.
# YOUTUBE_API_KEY=your_youtube_api_key

# === Service URLs ===
# Both FRONTEND_URL and API_URL must point to the Cloudflare Pages domain (not the VPS).
# OAuth callbacks are routed through Cloudflare Worker → VPS, so cookies are set on the
# Cloudflare domain and SameSite=Lax works correctly for all API requests.
FRONTEND_URL=https://your-project.pages.dev
API_URL=https://your-project.pages.dev
TWITCH_BOT_URL=http://twitch-bot:4344
DISCORD_BOT_URL=http://discord-bot:8080

# === Server ===
ENVIRONMENT=production
PYTHONUNBUFFERED=1
PORT=8000
# LOG_LEVEL=INFO
