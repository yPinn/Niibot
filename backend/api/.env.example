# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=7
# 部署必填且不可任意更換。產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

