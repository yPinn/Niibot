# API service env.
# Local dev: copy to .env and fill in. Production: injected from GitHub Secrets.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# Public URL — used for OAuth redirect URIs and webhook callbacks
API_URL=

ENVIRONMENT=production

# GitHub Personal Access Token — needs read:contents (or repo) scope for private repo releases
# Generate at github.com/settings/tokens
RELEASES_GITHUB_TOKEN=

# Discord application public key — found at discord.com/developers/applications > General Information
# Required for webhook signature verification (Discord Webhook Events)
DISCORD_PUBLIC_KEY=
