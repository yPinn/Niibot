# API service.
# Copy to .env and fill in values. Never commit .env.

# ── Auth ──────────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL used for OAuth redirect URIs and webhook callbacks
API_URL=
ENVIRONMENT=production

# ── Integrations ──────────────────────────────────────────────────────────────
# github.com/settings/tokens — read:contents (or repo) scope for private releases
RELEASES_GITHUB_TOKEN=
# discord.com/developers/applications → General Information → Public Key
DISCORD_PUBLIC_KEY=
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# API_URL=http://localhost:8000
# ENVIRONMENT=development
# PORT=8000
# LOG_LEVEL=INFO
