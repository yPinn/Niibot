# Twitch OAuth - dev.twitch.tv
CLIENT_ID=
CLIENT_SECRET=

# JWT - python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# Service URLs
# Dev:  FRONTEND_URL=http://localhost:3000 / API_URL=http://localhost:8000
# Prod: both point to CF Pages domain - CF Worker proxies /api/* to the backend tunnel,
#       so cookies are set on the CF Pages domain and SameSite=Lax works correctly.
FRONTEND_URL=
API_URL=
TWITCH_BOT_URL=http://twitch-bot:4344
DISCORD_BOT_URL=http://discord-bot:8080

# Server
# ENVIRONMENT: development | production
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=
