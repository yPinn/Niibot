# API service env.
# Local dev: copy to .env and fill in. Production: injected from GitHub Secrets.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# Public URL — used for OAuth redirect URIs and webhook callbacks
API_URL=

ENVIRONMENT=production
