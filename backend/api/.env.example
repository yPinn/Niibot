# === Twitch OAuth ===
CLIENT_ID=your_twitch_client_id_here
CLIENT_SECRET=your_twitch_client_secret_here

# === Authentication ===
JWT_SECRET_KEY=your_jwt_secret_key_here
# JWT_ALGORITHM=HS256                   # Default: HS256
# JWT_EXPIRE_DAYS=30                    # Default: 30

# === Database (local PostgreSQL via Docker) ===
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in root .env
DATABASE_URL=postgresql://your_db_user_here:your_db_password_here@postgres:5432/your_db_name_here

# === Discord OAuth ===
# DISCORD_CLIENT_ID=your_discord_client_id_here
# DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# === Service URLs ===
# Frontend is deployed on Cloudflare Pages; set to your Pages domain
FRONTEND_URL=https://your-project.pages.dev
# Used as OAuth redirect_uri base — set to CF Pages domain so OAuth callbacks
# route through CF Functions proxy and never expose the VPS IP to the browser
API_URL=https://your-project.pages.dev
# Bot URLs use Docker internal service names (no external port needed)
TWITCH_BOT_URL=http://twitch-bot:4344
DISCORD_BOT_URL=http://discord-bot:8080

# === Server ===
ENVIRONMENT=production                  # development | production
PYTHONUNBUFFERED=1
# LOG_LEVEL=INFO                        # Default: INFO
# HOST=0.0.0.0                          # Default: 0.0.0.0
PORT=8000

