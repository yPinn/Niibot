# API service environment variables.
# Production: written automatically from GitHub Secrets on each deploy (see .github/workflows/deploy.yml).
# Local dev: copy to .env and fill in values. Never commit .env.

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_DAYS=30

# API server URL (CF Pages domain in prod)
API_URL=

ENVIRONMENT=production
