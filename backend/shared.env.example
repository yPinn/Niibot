# GENERATED by scripts/env/gen.py — do not edit; edit env.registry.toml
# Shared backend env template.
# Create a runtime set with: npm run nb -- env init <dev|stg|prod>
# Never commit runtime env files.

# ── Database ──────────────────────────────────────────────────────────────────
# 僅供本機直跑；容器改用 DOCKER_DATABASE_URL。
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/niibot

# ── App ───────────────────────────────────────────────────────────────────────
# 供 CORS、OAuth redirect 與公開素材使用。
FRONTEND_URL=
# development、staging 或 production。
ENVIRONMENT=development

# ── Twitch ────────────────────────────────────────────────────────────────────
# prod 與 nonprod 各一組；dev 使用 staging 值。
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 初始化時產生；加密既有 token 後不可更換。
TWITCH_TOKEN_ENCRYPTION_KEY=
# 填數字 ID；prod 與 nonprod 使用不同 bot 帳號。
BOT_ID=
OWNER_ID=

