# Shared — consumed by api, twitch-bot, and discord-bot.
# Copy to shared.env and fill in values. Never commit shared.env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: use localhost + the port exposed by docker-compose.dev.yml (5433).
# Docker: overridden by DOCKER_DATABASE_URL from root .env via docker-compose.yml.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# ── App ───────────────────────────────────────────────────────────────────────
# OAuth redirect origin + CORS allow-list (used by api and twitch-bot)
FRONTEND_URL=

# ── Twitch ────────────────────────────────────────────────────────────────────
# App credentials: dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Bot and owner Twitch user IDs: id.twitch.tv
BOT_ID=
OWNER_ID=

# ── AI (set at least one; empty keys are skipped) ─────────────────────────────
# Priority: Groq → Gemini → OpenRouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# aistudio.google.com — AI Studio key (not a GCP service account key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Integrations ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# LOG_LEVEL=DEBUG
