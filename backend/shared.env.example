# Shared env — read by api, twitch-bot, and discord-bot.
# Local dev: copy to shared.env and fill in. Production: injected from GitHub Secrets.
# Override specific values locally with shared.env.local (gitignored).

# PostgreSQL
# Local dev: use localhost:5433 (exposed by docker-compose.dev.yml).
# Docker: overridden by DOCKER_DATABASE_URL in root .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# Frontend URL — OAuth redirect origin and CORS allow-list
FRONTEND_URL=

# Twitch App credentials — dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch identity — numeric user IDs, look up at id.twitch.tv
BOT_ID=
OWNER_ID=

# YouTube Data API v3 (optional — video queue metadata)
YOUTUBE_API_KEY=

# AI providers — set at least one. Priority order: Groq → Gemini → OpenRouter.
# Empty keys are skipped automatically.

# Groq — console.groq.com (free tier, no billing required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — aistudio.google.com (use AI Studio key, NOT a Google Cloud project key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter — openrouter.ai (free :free models; fallbacks from data/free_models.json)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional
# LOG_LEVEL=INFO
# ERROR_WEBHOOK_URL=   # Discord webhook for ERROR/CRITICAL alerts
