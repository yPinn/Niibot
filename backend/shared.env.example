# GENERATED by scripts/env/gen.py — do not edit; edit env.registry.toml
# Shared backend env template.
# Create a runtime set with: npm run nb -- env init <dev|stg|prod>
# Never commit runtime env files.

# ── Database ──────────────────────────────────────────────────────────────────
# Local runs only; inside Docker this is overridden by DOCKER_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/niibot

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=
ENVIRONMENT=development

# ── Twitch ────────────────────────────────────────────────────────────────────
# From dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Local env init generates this once when blank. Keep the same key for the lifetime of stored Twitch credentials.
TWITCH_TOKEN_ENCRYPTION_KEY=
# Numeric Twitch user IDs, not usernames.
BOT_ID=
OWNER_ID=

# ── AI ────────────────────────────────────────────────────────────────────────
# Set at least one provider key and its explicit model. Twitch: Groq → OpenRouter; Discord: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# From aistudio.google.com; not a GCP service account.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# ── Integrations ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# ENVIRONMENT=development
# Docker sets this; only needed for direct-run.
# INSTAFIX_HOST=localhost:3002
# LOG_LEVEL=DEBUG
