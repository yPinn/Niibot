# Shared environment variables loaded by all backend services.
# Copy to shared.env and fill in values.

# PostgreSQL - must match root .env (POSTGRES_USER / PASSWORD / DB)
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/niibot

# YouTube Data API v3 (optional - video title/duration metadata)
YOUTUBE_API_KEY=

# AI (OpenRouter) - optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
