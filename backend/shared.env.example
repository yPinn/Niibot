# Shared environment variables — used by api, twitch-bot, and discord-bot.
# Copy to shared.env and fill in values. Never commit shared.env.

# PostgreSQL
# Local dev: use localhost + the port exposed by docker-compose.dev.yml (5433 avoids conflicts).
# Docker (prod): DATABASE_URL is overridden by DOCKER_DATABASE_URL in root .env via docker-compose.yml.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# Twitch App credentials (dev.twitch.tv)
# Used by: twitch-bot (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET)
#          api        (CLIENT_ID / CLIENT_SECRET — same values, set separately in api/.env)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 (optional — for video queue metadata)
YOUTUBE_API_KEY=

# OpenRouter AI (optional — for AI-powered features)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Logging (optional — default: INFO)
# LOG_LEVEL=INFO

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=
