# Shared — api, twitch-bot, discord-bot.

# Local dev uses the exposed port; Docker injects DOCKER_DATABASE_URL instead.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# OAuth redirect origin + CORS allow-list
FRONTEND_URL=

# dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# id.twitch.tv
BOT_ID=
OWNER_ID=

# AI — set at least one; empty keys are skipped. Priority: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# aistudio.google.com — AI Studio key, not a GCP project key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

YOUTUBE_API_KEY=
# ERROR_WEBHOOK_URL=

# ── Dev ──────────────────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# LOG_LEVEL=DEBUG
