# Shared environment variables — used by api, twitch-bot, and discord-bot.
# Production: written automatically from GitHub Secrets on each deploy (see .github/workflows/deploy.yml).
# Local dev: copy to shared.env and fill in values. Never commit shared.env.

# PostgreSQL
# Local dev: use localhost + the port exposed by docker-compose.dev.yml (5433 avoids conflicts).
# Docker (prod): DATABASE_URL is overridden by DOCKER_DATABASE_URL in root .env via docker-compose.yml.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# Frontend URL (OAuth redirect + CORS — used by api and twitch)
FRONTEND_URL=

# Twitch App credentials (dev.twitch.tv) — also read by api via alias
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch bot identity (numeric user IDs — find at id.twitch.tv)
BOT_ID=
OWNER_ID=

# YouTube Data API v3 (optional — for video queue metadata)
YOUTUBE_API_KEY=

# AI providers — set at least one to enable AI commands.
# Priority order: Groq → Gemini → OpenRouter.
# Providers with empty keys are skipped automatically.

# Groq (free tier, no billing required — console.groq.com)
# Free: 1,000 req/day, 30 RPM for llama-3.3-70b-versatile. Never charges if no payment method added.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini AI Studio (free tier — aistudio.google.com → Get API key)
# Use the AI Studio key only (NOT a Google Cloud project key) to guarantee zero billing risk.
# Free: 1,500 req/day, 15 RPM for gemini-1.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (free :free models — openrouter.ai)
# Free models: 1,000 req/day after any $10 credit load; 50 req/day without credits.
# Fallback models loaded from data/free_models.json.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Logging (optional — default: INFO)
# LOG_LEVEL=INFO

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=
