# GENERATED by scripts/gen_env.py — do not edit; edit env.registry.toml
# Shared — consumed by api, twitch-bot, and discord-bot.
# Copy to shared.env and fill in values. Never commit it.

# ── Database ──────────────────────────────────────────────────────────────────
# Local runs only; inside Docker this is overridden by DOCKER_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/niibot

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
FRONTEND_URL=

# ── Twitch ────────────────────────────────────────────────────────────────────
# Numeric Twitch user IDs, not usernames.
BOT_ID=
OWNER_ID=
# From dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWITCH_TOKEN_ENCRYPTION_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# From aistudio.google.com; not a GCP service account.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Set at least one provider key and its explicit model. Twitch: Groq → OpenRouter; Discord: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# ── Integrations ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# ERROR_WEBHOOK_URL=

# ── Dev ───────────────────────────────────────────────────────────────────────
# ENVIRONMENT=development
# FRONTEND_URL=http://localhost:3000
# LOG_LEVEL=DEBUG
