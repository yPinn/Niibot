# Shared environment variables — copy to shared.env and fill in values.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/niibot

# Twitch App (dev.twitch.tv)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=

# OpenRouter AI (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Logging (optional — default: INFO)
# LOG_LEVEL=INFO

# Error reporting — Discord webhook URL for ERROR/CRITICAL alerts (optional)
# ERROR_WEBHOOK_URL=
