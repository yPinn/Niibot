{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "preview": "vite preview",
    "build": "npm run assets:tarot:check && npm run fa:subset && tsc -b && vite build",
    "assets:tarot:check": "node scripts/validate-tarot-assets.mjs",
    "fa:subset": "node scripts/build-fa-subset.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:cov": "vitest --coverage"
  },
