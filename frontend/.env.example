# Frontend (Vite).
# Copy to .env and fill in values. Never commit .env.

# ── App ───────────────────────────────────────────────────────────────────────
VITE_BOT_USERNAME=niibot_
VITE_DISCORD_COMMUNITY_URL=
VITE_DISCORD_BOT_INVITE_URL=
VITE_SUPPORT_ECPAY_URL=

# ── Deployment ────────────────────────────────────────────────────────────────
# Deployment target. Locks WIP pages only when 'production'; set 'staging' to unlock.
# VITE_ENVIRONMENT=production

# ── Dev ───────────────────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:8000   # dev server proxy; unset in production
