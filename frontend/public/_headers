/\*

# 'sha256-BFYo...' is the Vite modulePreload polyfill injected by older builds (kept for CDN cache

# rollover). Cloudflare sends all matching rules simultaneously; the browser enforces all of them.

# frame-ancestors is intentionally omitted here — X-Frame-Options: SAMEORIGIN handles non-overlay

# pages, while overlay paths override framing via their own CSP frame-ancestors \* rule below.

Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BFYoPoqqEce9Xn1iR84eJv0srIQYK8o0bOd6a5It8Ng=' https://www.youtube.com https://player.twitch.tv https://embed.twitch.tv https://static.cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://player.twitch.tv https://clips.twitch.tv; img-src 'self' https://static-cdn.jtvnw.net https://cdn.discordapp.com data:; connect-src 'self' https://niibot-api.llazypilot.com https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: camera=(), microphone=(), geolocation=()
X-Content-Type-Options: nosniff
X-Frame-Options: SAMEORIGIN

/images/tarot/decks/*

# Deck versions are immutable; changing artwork requires a new deck id or version directory.

Cache-Control: public, max-age=31536000, immutable

/live-display

# Community Overlay carries its capability in the fragment so it never reaches request logs.

Referrer-Policy: no-referrer
Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; frame-ancestors *; img-src 'self' data:; connect-src 'self' https://niibot-api.llazypilot.com https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'
! X-Frame-Options

/\*/video-queue/overlay

# Overlay pages must be embeddable in OBS Browser Source and the dashboard preview iframe.

# frame-ancestors \* overrides the inherited X-Frame-Options: SAMEORIGIN from the global rule.

# X-Frame-Options is intentionally omitted here; frame-ancestors takes precedence in modern browsers.

Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://player.twitch.tv https://embed.twitch.tv https://static.cloudflareinsights.com; frame-src https://www.youtube.com https://player.twitch.tv https://clips.twitch.tv; frame-ancestors \*; img-src 'self' https://static-cdn.jtvnw.net https://cdn.discordapp.com data:; connect-src 'self' https://niibot-api.llazypilot.com https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'

/\*/game-queue/overlay

# Same embedding policy as video-queue overlay — see comment above.

Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://player.twitch.tv https://embed.twitch.tv https://static.cloudflareinsights.com; frame-src https://www.youtube.com https://player.twitch.tv https://clips.twitch.tv; frame-ancestors \*; img-src 'self' https://static-cdn.jtvnw.net https://cdn.discordapp.com data:; connect-src 'self' https://niibot-api.llazypilot.com https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'
